#!/usr/bin/env zsh
set -euo pipefail

script_dir="${0:A:h}"
cd "$script_dir"

audit=0
if [[ "${1:-}" == "--audit" ]]; then
  shift
  audit=1
fi

if [[ "${1:-}" == "--cli" ]]; then
  shift
  mode="cli"
else
  mode="web"
fi

if (( audit )) && [[ "$mode" == "cli" ]]; then
  print "--audit currently supports Web mode only."
  exit 2
fi

if ! command -v gh >/dev/null 2>&1; then
  print "GitHub CLI is required for GitHub account login."
  print "Install it with: brew install gh"
  print "Then sign in with: gh auth login --hostname github.com --web"
  exit 2
fi

if ! gh auth status --hostname github.com >/dev/null 2>&1; then
  print "Starting GitHub account login..."
  gh auth login --hostname github.com --web --git-protocol https
fi

python_cmd=()

if python -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)' >/dev/null 2>&1; then
  python_cmd=(python)
elif python3 -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)' >/dev/null 2>&1; then
  python_cmd=(python3)
fi

if (( ${#python_cmd[@]} == 0 )); then
  print "Python 3.11+ is required. Activate a Python 3.11+ environment, then run ./start again."
  exit 2
fi

if [[ "$mode" == "cli" ]]; then
  exec "${python_cmd[@]}" chat_cli.py "$@"
fi

port="8002"
if [[ -n "${COPILOT_WEB_PORT:-}" && "$COPILOT_WEB_PORT" != "$port" ]]; then
  print "This project uses one canonical Web port: ${port}."
  print "Unset COPILOT_WEB_PORT and open http://127.0.0.1:${port}/."
  exit 2
fi
url="http://127.0.0.1:${port}"

health_json=""
if command -v curl >/dev/null 2>&1; then
  health_json="$(curl -fsS --max-time 1 "$url/health" 2>/dev/null || true)"
fi

running_project=""
if [[ -n "$health_json" ]]; then
  running_project="$("${python_cmd[@]}" -c 'import json, sys; print(json.loads(sys.argv[1]).get("projectDir", ""))' "$health_json" 2>/dev/null || true)"
fi

if [[ "$running_project" == "$script_dir" ]]; then
  if (( audit )); then
    print "Inflak Demo is already running at ${url}."
    print "Stop that process before running ./start --audit on the same canonical port."
    exit 2
  fi
  print "Inflak Demo is already running at ${url}"
  print "Reusing the existing server and browser page."
  exit 0
fi

port_in_use=0
if [[ -n "$health_json" ]]; then
  port_in_use=1
elif command -v lsof >/dev/null 2>&1 && lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1; then
  port_in_use=1
fi

if (( port_in_use )); then
  print "Port ${port} is already used by another application."
  print "This project keeps one canonical Web instance; stop the other listener before starting it."
  exit 2
fi

print "Starting Inflak Demo at ${url}"
print "Use ./start --cli for the terminal fallback."
export COPILOT_OPEN_BROWSER="${COPILOT_OPEN_BROWSER:-1}"
export COPILOT_WEB_URL="$url"
if [[ "$COPILOT_OPEN_BROWSER" == "1" && -z "${COPILOT_BROWSER_MARKER:-}" ]]; then
  export COPILOT_BROWSER_MARKER="${TMPDIR:-/tmp}/inflak-demo-${port}-$$-$(date +%s).browser-opened"
fi

if (( audit )); then
  run_id="$(date -u +%Y%m%dT%H%M%SZ)-$$"
  audit_dir="$script_dir/data/runtime_audit/$run_id"
  mkdir -p "$audit_dir"
  print -r -- "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$audit_dir/started-at.txt"
  export COVERAGE_FILE="$audit_dir/.coverage"
  print "Runtime audit enabled: $audit_dir"

  audit_pid=""
  stop_audit() {
    if [[ -n "$audit_pid" ]] && kill -0 "$audit_pid" 2>/dev/null; then
      kill -USR1 "$audit_pid" 2>/dev/null || true
      kill -INT "$audit_pid" 2>/dev/null || true
    fi
  }
  trap stop_audit INT TERM

  set +e
  "${python_cmd[@]}" -m coverage run --save-signal=USR1 --branch --source=backend -m uvicorn backend.server:app --host 127.0.0.1 --port "$port" &
  audit_pid=$!
  wait "$audit_pid"
  exit_code=$?
  set -e
  trap - INT TERM

  print -r -- "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$audit_dir/finished-at.txt"
  if "${python_cmd[@]}" -m coverage json --pretty-print -o "$audit_dir/backend-coverage.json"; then
    print "Runtime audit saved: $audit_dir/backend-coverage.json"
  else
    print "Runtime audit warning: coverage data was not available; session tool events are still persisted."
  fi
  exit "$exit_code"
fi

reload_args=()
if [[ "${COPILOT_WEB_RELOAD:-1}" != "0" ]]; then
  reload_args=(--reload --reload-dir "$script_dir")
  print "Auto reload enabled for Python changes."
fi

exec "${python_cmd[@]}" -m uvicorn backend.server:app --host 127.0.0.1 --port "$port" "${reload_args[@]}"